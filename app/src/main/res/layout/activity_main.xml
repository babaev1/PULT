<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- Panel 1: Pairing Screen -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pairingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="visible">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnToControl"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/button_rounded"
            android:text="←CONNECT"
            android:textColor="@android:color/white"
            app:layout_constraintHeight_percent="0.16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.25" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDisconnect"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_rounded"
            android:text="DISCONNECT"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.16"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.25" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPairForget"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_rounded"
            android:text="PAIR"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.16"
            app:layout_constraintTop_toBottomOf="@id/btnDisconnect"
            app:layout_constraintWidth_percent="0.25" />

        <!-- Окно BLE устройств (80% высоты, 45% ширины) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/devicesRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scrollbars="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.45" />

        <ProgressBar
            android:id="@+id/scanProgressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/statusTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Status: Disconnected"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Panel 2: Control Screen -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone"
        tools:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnToPairing"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/button_rounded"
            android:text="PAIRING »"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHeight_percent="0.16"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.16" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnL1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/button_rounded"
            android:text="L1"
            android:textColor="@android:color/white"
            app:layout_constraintHeight_percent="0.16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.15" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnL2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_rounded"
            android:text="L2"
            android:textColor="@android:color/white"
            app:layout_constraintHeight_percent="0.16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnL1"
            app:layout_constraintWidth_percent="0.15" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnR1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/button_rounded"
            android:text="R1"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.16"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.15" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnR2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_rounded"
            android:text="R2"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.16"
            app:layout_constraintTop_toBottomOf="@id/btnR1"
            app:layout_constraintWidth_percent="0.15" />

        <!-- F1-F5 Column -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnF1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/button_rounded"
            android:text="F1"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/btnF2"
            app:layout_constraintEnd_toStartOf="@+id/btnToPairing"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintStart_toEndOf="@+id/btnL1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintWidth_percent="0.20" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnF2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/button_rounded"
            android:text="F2"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/btnF3"
            app:layout_constraintEnd_toStartOf="@+id/btnToPairing"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintStart_toEndOf="@+id/btnL1"
            app:layout_constraintTop_toBottomOf="@+id/btnF1"
            app:layout_constraintWidth_percent="0.20" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnF3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/button_rounded"
            android:text="F3"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/btnF4"
            app:layout_constraintEnd_toStartOf="@+id/btnToPairing"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintStart_toEndOf="@+id/btnL1"
            app:layout_constraintTop_toBottomOf="@+id/btnF2"
            app:layout_constraintWidth_percent="0.20" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnF4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/button_rounded"
            android:text="F4"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/btnF5"
            app:layout_constraintEnd_toStartOf="@+id/btnToPairing"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintStart_toEndOf="@+id/btnL1"
            app:layout_constraintTop_toBottomOf="@+id/btnF3"
            app:layout_constraintWidth_percent="0.20" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnF5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/button_rounded"
            android:text="F5"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/statusTextViewControl"
            app:layout_constraintEnd_toStartOf="@+id/btnToPairing"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintStart_toEndOf="@+id/btnL1"
            app:layout_constraintTop_toBottomOf="@+id/btnF4"
            app:layout_constraintWidth_percent="0.20" />

        <!-- F6-F10 Column -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnF6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/button_rounded"
            android:text="F6"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/btnF7"
            app:layout_constraintEnd_toStartOf="@+id/btnR1"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintStart_toEndOf="@+id/btnToPairing"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintWidth_percent="0.20" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnF7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/button_rounded"
            android:text="F7"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/btnF8"
            app:layout_constraintEnd_toStartOf="@+id/btnR1"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintStart_toEndOf="@+id/btnToPairing"
            app:layout_constraintTop_toBottomOf="@+id/btnF6"
            app:layout_constraintWidth_percent="0.20" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnF8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/button_rounded"
            android:text="F8"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/btnF9"
            app:layout_constraintEnd_toStartOf="@+id/btnR1"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintStart_toEndOf="@+id/btnToPairing"
            app:layout_constraintTop_toBottomOf="@+id/btnF7"
            app:layout_constraintWidth_percent="0.20" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnF9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/button_rounded"
            android:text="F9"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/btnF10"
            app:layout_constraintEnd_toStartOf="@+id/btnR1"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintStart_toEndOf="@+id/btnToPairing"
            app:layout_constraintTop_toBottomOf="@+id/btnF8"
            app:layout_constraintWidth_percent="0.20" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnF10"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/button_rounded"
            android:text="F10"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toTopOf="@+id/statusTextViewControl"
            app:layout_constraintEnd_toStartOf="@+id/btnR1"
            app:layout_constraintHeight_percent="0.15"
            app:layout_constraintStart_toEndOf="@+id/btnToPairing"
            app:layout_constraintTop_toBottomOf="@+id/btnF9"
            app:layout_constraintWidth_percent="0.20" />

        <TextView
            android:id="@+id/statusTextViewControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Status: Disconnected"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Левый джойстик -->
        <com.example.roki_pult.JoystickView
            android:id="@+id/joystickViewLeft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.2" />

        <!-- Правый джойстик -->
        <com.example.roki_pult.JoystickView
            android:id="@+id/joystickViewRight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>